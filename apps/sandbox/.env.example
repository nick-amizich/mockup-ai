# Server Port
PORT=3001

# ============================================
# Authentication: Claude Max Subscription
# ============================================
#
# This service uses the Claude Code SDK which authenticates
# via your Max subscription - NO API KEY NEEDED!
#
# Setup steps:
# 1. Install Claude Code globally:
#    npm install -g @anthropic-ai/claude-code
#
# 2. Login with your Max subscription:
#    claude login
#
# 3. Start the sandbox service:
#    npm run dev
#
# The SDK automatically uses your stored auth tokens.
# All API calls go through your Max subscription quota.
#
# ============================================
