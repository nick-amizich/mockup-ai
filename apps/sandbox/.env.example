# Server Port
PORT=3001

# ============================================
# Authentication Options
# ============================================
#
# Option 1: API Key (Production/Cloud)
# ------------------------------------
# Set this for cloud deployment (Digital Ocean, etc.)
# Get your API key from: https://console.anthropic.com/
#
# ANTHROPIC_API_KEY=sk-ant-your-api-key-here
#
# Option 2: Claude Max Subscription (Local Development)
# -----------------------------------------------------
# If no API key is set, the service uses your local Claude CLI auth.
# This is ideal for local development with a Max subscription.
#
# Setup steps:
# 1. Install Claude Code globally:
#    npm install -g @anthropic-ai/claude-code
#
# 2. Login with your Max subscription:
#    claude login
#
# 3. Start the sandbox service:
#    npm run dev
#
# The SDK automatically uses your stored auth tokens.
#
# ============================================
